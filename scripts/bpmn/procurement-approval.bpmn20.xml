          <dc:Bounds x="66" y="563" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- 品类网关 -->
      <bpmndi:BPMNShape id="gw_category_di" bpmnElement="gw-category" isMarkerVisible="true">
        <dc:Bounds x="180" y="513" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="165" y="570" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- IT金额网关 -->
      <bpmndi:BPMNShape id="gw_it_amount_di" bpmnElement="gw-it-amount" isMarkerVisible="true">
        <dc:Bounds x="300" y="133" width="50" height="50" />
