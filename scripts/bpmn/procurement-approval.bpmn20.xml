<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:flowable="http://flowable.org/bpmn"
  xmlns:omni="http://omni.com/workflow"
  id="Definitions_procurement"
  targetNamespace="http://flowable.org/test"
  xsi:schemaLocation="http://www.omg.org/spec/BPMN20 http://www.omg.org/spec/BPMN20/bpmn20.xsd">

  <process id="procurement-approval" name="采购请购审批（品类+金额路由）" isExecutable="true">
    <documentation>通用采购请购审批流程：按物料品类一级分支，再按金额二级路由到不同审批人。</documentation>

    <!-- 开始事件 -->
    <startEvent id="start" name="提交请购" flowable:initiator="initiator" />

    <!-- ========== 一级网关：按品类分支 ========== -->
    <exclusiveGateway id="gw-category" name="按品类分支" default="flow-to-general" />

    <!-- ================================================================ -->
    <!-- IT 设备品类                                                      -->
    <!-- ================================================================ -->
    <exclusiveGateway id="gw-it-amount" name="IT金额分支" default="flow-it-low" />

    <!-- IT 低金额：直属领导会签 -->
    <userTask id="it-low-approve" name="IT 直属领导审批" flowable:assignee="${userId}">
      <documentation>IT设备&lt;5万，发起人所在组织组长会签</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"TEAM_LEADER","anchorType":"START_USER_PRIMARY_UNIT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ALL"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <!-- IT 高金额：部门领导 -->
    <userTask id="it-high-dept" name="IT 部门领导审批" flowable:assignee="${userId}">
      <documentation>IT设备≥5万，上级组织部门领导会签</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"DEPT_LEADER","anchorType":"PARENT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <!-- IT 高金额第二级：CTO -->
    <userTask id="it-high-cto" name="CTO 审批" flowable:assignee="${userId}">
      <documentation>IT设备≥5万第二级，CTO审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"DEPT_LEADER","anchorType":"ABSOLUTE_UNIT","anchorParams":{"unitIds":[200]},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <exclusiveGateway id="gw-it-high" name="IT高金额结果" default="flow-it-high-reject" />

    <!-- ================================================================ -->
    <!-- 办公用品品类                                                      -->
    <!-- ================================================================ -->
    <exclusiveGateway id="gw-office-amount" name="办公用品金额分支" default="flow-office-low" />

    <userTask id="office-low-approve" name="行政主管审批" flowable:assignee="${userId}">
      <documentation>办公用品&lt;1万，行政主管审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"TEAM_LEADER","anchorType":"START_USER_PRIMARY_UNIT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <userTask id="office-high-admin" name="行政主管审批" flowable:assignee="${userId}">
      <documentation>办公用品≥1万第一级，行政主管审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"TEAM_LEADER","anchorType":"START_USER_PRIMARY_UNIT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <userTask id="office-high-director" name="行政总监审批" flowable:assignee="${userId}">
      <documentation>办公用品≥1万第二级，行政总监审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"DEPT_LEADER","anchorType":"PARENT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <exclusiveGateway id="gw-office-high" name="办公用品高金额结果" default="flow-office-high-reject" />

    <!-- ================================================================ -->
    <!-- 原材料品类                                                        -->
    <!-- ================================================================ -->
    <exclusiveGateway id="gw-raw-amount" name="原材料金额分支" default="flow-raw-low" />

    <userTask id="raw-low-approve" name="采购经理审批" flowable:assignee="${userId}">
      <documentation>原材料&lt;10万，采购经理审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"PROCUREMENT_MANAGER","anchorType":"START_USER_PRIMARY_UNIT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <userTask id="raw-high-proc" name="采购经理审批" flowable:assignee="${userId}">
      <documentation>原材料≥10万第一级，采购经理审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"PROCUREMENT_MANAGER","anchorType":"START_USER_PRIMARY_UNIT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <userTask id="raw-high-vp" name="供应链VP审批" flowable:assignee="${userId}">
      <documentation>原材料≥10万第二级，供应链VP审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"DEPT_LEADER","anchorType":"PARENT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <exclusiveGateway id="gw-raw-high" name="原材料高金额结果" default="flow-raw-high-reject" />

    <!-- ================================================================ -->
    <!-- 其他品类（默认分支）                                                -->
    <!-- ================================================================ -->
    <exclusiveGateway id="gw-general-amount" name="通用金额分支" default="flow-general-low" />

    <userTask id="general-low-approve" name="部门负责人审批" flowable:assignee="${userId}">
      <documentation>其他品类&lt;3万，需求部门负责人审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"DEPT_LEADER","anchorType":"START_USER_PRIMARY_UNIT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <userTask id="general-high-dept" name="部门负责人审批" flowable:assignee="${userId}">
      <documentation>其他品类≥3万第一级，需求部门负责人审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"DEPT_LEADER","anchorType":"START_USER_PRIMARY_UNIT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <userTask id="general-high-cfo" name="CFO 审批" flowable:assignee="${userId}">
      <documentation>其他品类≥3万第二级，CFO审批</documentation>
      <extensionElements>
        <omni:assignment>{"roleCode":"DEPT_LEADER","anchorType":"PARENT","anchorParams":{},"scopeMode":"SAME_UNIT","fallbackStrategy":"ERROR","approvalMode":"ANY"}</omni:assignment>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false"
        flowable:collection="${candidateResolver.resolve(execution)}"
        flowable:elementVariable="userId">
        <completionCondition xsi:type="tFormalExpression">${rejectedCount > 0 || approvedCount >= requiredApprovals}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>

    <exclusiveGateway id="gw-general-high" name="通用高金额结果" default="flow-general-high-reject" />

    <!-- ========== 汇聚网关 ========== -->
    <exclusiveGateway id="gw-approved-merge" name="审批通过汇聚" default="flow-to-end-approved" />

    <!-- 结束事件 -->
    <endEvent id="end-approved" name="审批通过" />
    <endEvent id="end-rejected" name="审批驳回" />

    <!-- ===== 流程连线 ===== -->

    <!-- 开始 → 品类网关 -->
    <sequenceFlow id="flow-start" sourceRef="start" targetRef="gw-category" />

    <!-- 品类 → IT设备 -->
    <sequenceFlow id="flow-to-it" sourceRef="gw-category" targetRef="gw-it-amount">
      <conditionExpression xsi:type="tFormalExpression">${materialCategory == 'IT_DEVICE'}</conditionExpression>
    </sequenceFlow>
    <!-- 品类 → 办公用品 -->
    <sequenceFlow id="flow-to-office" sourceRef="gw-category" targetRef="gw-office-amount">
      <conditionExpression xsi:type="tFormalExpression">${materialCategory == 'OFFICE_SUPPLY'}</conditionExpression>
    </sequenceFlow>
    <!-- 品类 → 原材料 -->
    <sequenceFlow id="flow-to-raw" sourceRef="gw-category" targetRef="gw-raw-amount">
      <conditionExpression xsi:type="tFormalExpression">${materialCategory == 'RAW_MATERIAL'}</conditionExpression>
    </sequenceFlow>
    <!-- 品类 → 其他（default） -->
    <sequenceFlow id="flow-to-general" sourceRef="gw-category" targetRef="gw-general-amount" />

    <!-- IT金额分支 -->
    <sequenceFlow id="flow-it-low" sourceRef="gw-it-amount" targetRef="it-low-approve" />
    <sequenceFlow id="flow-it-high" sourceRef="gw-it-amount" targetRef="it-high-dept">
      <conditionExpression xsi:type="tFormalExpression">${totalAmount >= 50000}</conditionExpression>
    </sequenceFlow>

    <!-- IT低金额 → 通过汇聚 -->
    <sequenceFlow id="flow-it-low-pass" sourceRef="it-low-approve" targetRef="gw-approved-merge" />

    <!-- IT高金额：部门领导 → CTO网关 -->
    <sequenceFlow id="flow-it-dept-to-gw" sourceRef="it-high-dept" targetRef="gw-it-high" />
    <sequenceFlow id="flow-it-high-pass" sourceRef="gw-it-high" targetRef="it-high-cto">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-it-high-reject" sourceRef="gw-it-high" targetRef="end-rejected" />

    <!-- IT高金额：CTO → 通过汇聚 -->
    <sequenceFlow id="flow-it-cto-pass" sourceRef="it-high-cto" targetRef="gw-approved-merge" />

    <!-- 办公用品金额分支 -->
    <sequenceFlow id="flow-office-low" sourceRef="gw-office-amount" targetRef="office-low-approve" />
    <sequenceFlow id="flow-office-high" sourceRef="gw-office-amount" targetRef="office-high-admin">
      <conditionExpression xsi:type="tFormalExpression">${totalAmount >= 10000}</conditionExpression>
    </sequenceFlow>

    <!-- 办公用品低金额 → 通过汇聚 -->
    <sequenceFlow id="flow-office-low-pass" sourceRef="office-low-approve" targetRef="gw-approved-merge" />

    <!-- 办公用品高金额：行政主管 → 行政总监网关 -->
    <sequenceFlow id="flow-office-admin-to-gw" sourceRef="office-high-admin" targetRef="gw-office-high" />
    <sequenceFlow id="flow-office-high-pass" sourceRef="gw-office-high" targetRef="office-high-director">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-office-high-reject" sourceRef="gw-office-high" targetRef="end-rejected" />

    <!-- 办公用品高金额：行政总监 → 通过汇聚 -->
    <sequenceFlow id="flow-office-dir-pass" sourceRef="office-high-director" targetRef="gw-approved-merge" />

    <!-- 原材料金额分支 -->
    <sequenceFlow id="flow-raw-low" sourceRef="gw-raw-amount" targetRef="raw-low-approve" />
    <sequenceFlow id="flow-raw-high" sourceRef="gw-raw-amount" targetRef="raw-high-proc">
      <conditionExpression xsi:type="tFormalExpression">${totalAmount >= 100000}</conditionExpression>
    </sequenceFlow>

    <!-- 原材料低金额 → 通过汇聚 -->
    <sequenceFlow id="flow-raw-low-pass" sourceRef="raw-low-approve" targetRef="gw-approved-merge" />

    <!-- 原材料高金额：采购经理 → 供应链VP网关 -->
    <sequenceFlow id="flow-raw-proc-to-gw" sourceRef="raw-high-proc" targetRef="gw-raw-high" />
    <sequenceFlow id="flow-raw-high-pass" sourceRef="gw-raw-high" targetRef="raw-high-vp">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-raw-high-reject" sourceRef="gw-raw-high" targetRef="end-rejected" />

    <!-- 原材料高金额：供应链VP → 通过汇聚 -->
    <sequenceFlow id="flow-raw-vp-pass" sourceRef="raw-high-vp" targetRef="gw-approved-merge" />

    <!-- 通用金额分支 -->
    <sequenceFlow id="flow-general-low" sourceRef="gw-general-amount" targetRef="general-low-approve" />
    <sequenceFlow id="flow-general-high" sourceRef="gw-general-amount" targetRef="general-high-dept">
      <conditionExpression xsi:type="tFormalExpression">${totalAmount >= 30000}</conditionExpression>
    </sequenceFlow>

    <!-- 通用低金额 → 通过汇聚 -->
    <sequenceFlow id="flow-general-low-pass" sourceRef="general-low-approve" targetRef="gw-approved-merge" />

    <!-- 通用高金额：部门负责人 → CFO网关 -->
    <sequenceFlow id="flow-general-dept-to-gw" sourceRef="general-high-dept" targetRef="gw-general-high" />
    <sequenceFlow id="flow-general-high-pass" sourceRef="gw-general-high" targetRef="general-high-cfo">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-general-high-reject" sourceRef="gw-general-high" targetRef="end-rejected" />

    <!-- 通用高金额：CFO → 通过汇聚 -->
    <sequenceFlow id="flow-general-cfo-pass" sourceRef="general-high-cfo" targetRef="gw-approved-merge" />

    <!-- 通过汇聚 → 审批通过结束 -->
    <sequenceFlow id="flow-to-end-approved" sourceRef="gw-approved-merge" targetRef="end-approved" />

  </process>

  <!-- BPMN 图形布局 -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_procurement">
    <bpmndi:BPMNPlane id="BPMNPlane_procurement" bpmnElement="procurement-approval">

      <!-- 开始事件 -->
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="520" width="36" height="36" />
