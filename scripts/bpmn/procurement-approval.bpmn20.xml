      </bpmndi:BPMNShape>

      <!-- IT高金额网关 -->
      <bpmndi:BPMNShape id="gw_it_high_di" bpmnElement="gw-it-high" isMarkerVisible="true">
        <dc:Bounds x="640" y="213" width="50" height="50" />
