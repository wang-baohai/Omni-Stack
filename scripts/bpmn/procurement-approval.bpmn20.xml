          <dc:Bounds x="625" y="270" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- IT CTO -->
      <bpmndi:BPMNShape id="it_high_cto_di" bpmnElement="it-high-cto">
        <dc:Bounds x="760" y="198" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- 办公用品金额网关 -->
      <bpmndi:BPMNShape id="gw_office_amount_di" bpmnElement="gw-office-amount" isMarkerVisible="true">
        <dc:Bounds x="300" y="353" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="278" y="410" width="94" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- 办公用品低金额审批 -->
      <bpmndi:BPMNShape id="office_low_di" bpmnElement="office-low-approve">
        <dc:Bounds x="420" y="278" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- 办公用品高金额行政主管 -->
      <bpmndi:BPMNShape id="office_high_admin_di" bpmnElement="office-high-admin">
        <dc:Bounds x="420" y="418" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- 办公用品高金额网关 -->
      <bpmndi:BPMNShape id="gw_office_high_di" bpmnElement="gw-office-high" isMarkerVisible="true">
        <dc:Bounds x="640" y="433" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="618" y="490" width="94" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- 办公用品行政总监 -->
      <bpmndi:BPMNShape id="office_high_dir_di" bpmnElement="office-high-director">
        <dc:Bounds x="760" y="418" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- 原材料金额网关 -->
      <bpmndi:BPMNShape id="gw_raw_amount_di" bpmnElement="gw-raw-amount" isMarkerVisible="true">
        <dc:Bounds x="300" y="573" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="630" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- 原材料低金额审批 -->
      <bpmndi:BPMNShape id="raw_low_di" bpmnElement="raw-low-approve">
        <dc:Bounds x="420" y="558" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- 原材料高金额采购经理 -->
      <bpmndi:BPMNShape id="raw_high_proc_di" bpmnElement="raw-high-proc">
        <dc:Bounds x="420" y="698" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- 原材料高金额网关 -->
      <bpmndi:BPMNShape id="gw_raw_high_di" bpmnElement="gw-raw-high" isMarkerVisible="true">
        <dc:Bounds x="640" y="713" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="618" y="770" width="94" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- 原材料供应链VP -->
      <bpmndi:BPMNShape id="raw_high_vp_di" bpmnElement="raw-high-vp">
        <dc:Bounds x="760" y="698" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- 通用金额网关 -->
      <bpmndi:BPMNShape id="gw_general_amount_di" bpmnElement="gw-general-amount" isMarkerVisible="true">
        <dc:Bounds x="300" y="813" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="870" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- 通用低金额审批 -->
      <bpmndi:BPMNShape id="general_low_di" bpmnElement="general-low-approve">
