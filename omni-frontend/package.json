{
  "name": "omni-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:wp009-f": "playwright test --config=playwright.wp009-f.config.ts",
    "docs:screenshots": "playwright test --config=playwright.docs.config.ts",
    "docs:screenshots:test": "node --experimental-strip-types --test e2e-docs/helpers/docs-page.test.ts",
    "docs:screenshots:public": "playwright test --config=playwright.docs.config.ts flows/public.flows.spec.ts",
    "docs:screenshots:check": "node ../tools/omni-cli/scripts/docs-quality.mjs --scope=screenshots",
    "docs:links:check": "node ../tools/omni-cli/scripts/docs-quality.mjs --scope=links",
    "docs:i18n:check": "node ../tools/omni-cli/scripts/docs-quality.mjs --scope=i18n",
    "docs:i18n:queue": "node ../tools/omni-cli/scripts/docs-review-queue.mjs --generate",
    "docs:readme:check": "node ../tools/omni-cli/scripts/docs-quality.mjs --scope=readme",
    "ui:i18n:audit": "node ../tools/omni-cli/scripts/ui-i18n-audit.mjs",
    "ui:i18n:check": "node ../tools/omni-cli/scripts/ui-i18n-audit.mjs --check",
    "ui:i18n:parity": "node ../tools/omni-cli/scripts/locale-parity-check.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:unit": "node --experimental-vm-modules --experimental-strip-types --test \"tests/wp012/*.test.ts\" \"tests/workflow/*.test.ts\" \"tests/base/*.test.ts\""
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bpmn-js": "^18.19.0",
    "cron-parser": "^5.6.0",
    "element-plus": "^2.14.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "bpmn-moddle": "10.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.2.0",
    "sass": "^1.100.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^8.0.14",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^3.3.2"
  }
}
