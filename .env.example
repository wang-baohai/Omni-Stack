# 复制为 .env 后，按各配置项要求替换为随机值。
OMNI_INTERNAL_API_TOKEN=replace-with-a-random-internal-service-token

# Gateway 与下游服务共享的 HMAC-SHA256 身份断言密钥（X-Gateway-Assertion）；缺失时 Gateway 对已认证请求 fail-closed 返回 503。≥ 32 字节随机值，必须全栈一致。
GATEWAY_ASSERTION_SECRET=replace-with-a-random-gateway-assertion-secret

# 本地 Compose 数据库账号；由 one-shot omni-db-migrator 创建并只授权七个应用库。
MYSQL_ROOT_PASSWORD=replace-with-a-random-mysql-root-password
OMNI_DB_PASSWORD=replace-with-a-random-app-database-password

# Redis、XXL-JOB 与 Nacos 均禁止空口令/仓库默认口令。
REDIS_PASSWORD=replace-with-a-random-redis-password
XXL_JOB_ACCESS_TOKEN=replace-with-a-random-xxl-job-token
# 正式引导账号固定为 admin；迁移器只替换尚未修改的公开种子密码。
# 管理界面密码输入上限为 20 字符；使用 14～20 字符的随机密码。
XXL_JOB_ADMIN_USERNAME=admin
XXL_JOB_ADMIN_PASSWORD=replace-with-a-random-xxl-job-password
NACOS_AUTH_TOKEN=replace-with-a-base64-secret-of-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-a-random-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-a-random-identity-value
# 控制台及所有服务客户端使用同一私有账号；迁移器只替换公开引导密码。
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-a-random-nacos-password

# 可选运行能力开关。完整模式默认开启；omni dev 会为轻量组合自动覆盖为关闭。
OMNI_RUNTIME_PROFILE=default
XXL_JOB_ENABLED=true
OMNI_MQ_RELAY_ENABLED=true
OMNI_MQ_AUTODETECT=true
NACOS_CLIENT_ENABLED=true

# 可选本地观测栈；通常由 `omni dev up --observability` 临时覆盖，不建议日常手工开启 100% 采样。
OTEL_SDK_ENABLED=false
OTLP_EXPORT_ENABLED=false
OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.0
STRUCTURED_LOGGING_FORMAT=ecs
OMNI_ENVIRONMENT=local
MIGRATION_PUSHGATEWAY_ENABLED=false
MIGRATION_PUSHGATEWAY_ADDRESS=pushgateway:9091
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-password
# PROMETHEUS_RETENTION=7d
# GRAFANA_HOST_PORT=3001
# PROMETHEUS_HOST_PORT=9090
# PUSHGATEWAY_HOST_PORT=9091
# NODE_EXPORTER_HOST_PORT=9100
# CADVISOR_HOST_PORT=8088
# ALERTMANAGER_HOST_PORT=9093
# TEMPO_HOST_PORT=3200
# LOKI_HOST_PORT=3100
# ALLOY_HOST_PORT=12345
# OTEL_GRPC_HOST_PORT=4317
# OTEL_HTTP_HOST_PORT=4318

# OAuth2 state 参数 HMAC-SHA256 签名密钥（至少 32 字节）
OAUTH2_STATE_SECRET=replace-with-random-state-secret

# JWK 密钥 AES-256-GCM 加密密钥（必须 32 字符，用于加密存入 Redis 的 RSA 密钥）
JWK_ENCRYPT_KEY=replace-with-32chars-aes-key!!

# 可选：并行隔离 Compose 项目时覆盖宿主机端口和数据库卷名；默认值见 compose.infra.yaml / compose.apps.yaml。
# 标准项目默认为 omni-stack，网络为 omni-stack_default；卷默认按项目隔离。
# 标准持久化卷：omni-stack_omni-mysql-data、omni-stack_omni-redis-data、omni-stack_omni-rocketmq-data。
# OMNI_MYSQL_VOLUME_NAME=omni-stack_omni-mysql-data
# OMNI_MYSQL_HOST_PORT=3306
# OMNI_REDIS_HOST_PORT=6379
# OMNI_NACOS_CONSOLE_HOST_PORT=8080
# OMNI_NACOS_API_HOST_PORT=8848
# OMNI_NACOS_GRPC_HOST_PORT=9848
# OMNI_ROCKETMQ_NAMESRV_HOST_PORT=19876
# OMNI_ROCKETMQ_FAST_HOST_PORT=10909
# OMNI_ROCKETMQ_BROKER_HOST_PORT=10911
# OMNI_ROCKETMQ_HA_HOST_PORT=10912
# OMNI_XXL_JOB_HOST_PORT=18080
# OMNI_AUTH_HOST_PORT=8100
# OMNI_BASE_HOST_PORT=8101
# OMNI_GATEWAY_HOST_PORT=8102
# OMNI_WORKFLOW_HOST_PORT=8103
# OMNI_CRM_HOST_PORT=8104
# OMNI_SRM_HOST_PORT=8105
# OMNI_PROCUREMENT_HOST_PORT=8106
# OMNI_ASSET_HOST_PORT=8107
# OMNI_FRONTEND_HOST_PORT=3000

# 可选：社交登录凭证（从各平台 OAuth 应用管理页获取）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Compose 镜像标签命名空间（非秘密）；隔离靶场建议设为 Compose project 名，避免多栈互相覆盖 omni-*:latest
OMNI_IMAGE_NAMESPACE=omni
