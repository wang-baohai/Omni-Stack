# 由 @omni-stack/cli {{generatorVersion}} 生成；这是自然键声明，不包含自增 ID。
module: {{serviceId}}
permissions:
  - type: DIRECTORY
    code: "{{serviceId}}"
    name: "{{displayName}}"
  - type: MENU
    code: "{{serviceId}}:read"
    name: "查看{{displayName}}"
    path: "/{{serviceId}}"
roles:
  - roleCode: SUPER_ADMIN
    permissionCodes:
      - "{{serviceId}}"
      - "{{serviceId}}:read"
