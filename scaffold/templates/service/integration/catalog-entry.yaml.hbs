# 由 @omni-stack/cli {{generatorVersion}} 生成；合并前必须执行 omni catalog validate。
- id: {{serviceId}}
  artifactId: {{artifactId}}
  kind: business
  version: "1.0.0-SNAPSHOT"
  dependencies:
    - platform
    - auth
    - base
  optionalModules: []
  conflicts: []
  backendModules: [{{artifactId}}]
  frontend:
    viewGlobs: []
    apiGlobs: []
    i18nGlobs: [omni-frontend/src/locales/*.ts]
    i18nPrefixes: [{{serviceId}}]
  # WP-011 S14 修正：接入器同时为内部 API 生成 per-service 拦截路由，必须一并归属，否则 catalog 反向扫描会报 unmanaged
  gatewayRoutes: [{{artifactId}}, block-internal-{{serviceId}}]
  composeServices: [{{artifactId}}]
  database:
    changelogs: [database/changelog/{{serviceId}}/db.changelog-{{serviceId}}.yaml]
    seedSourceIds: []
  tenantProvisioning: none
  permissionRoots:
    - "{{serviceId}}"
  provisioningSeedIds: []
  nacosConfigs: [{{artifactId}}.yml]
  ports: [{{servicePort}}, {{managementPort}}]
  # 预览用途：真实接入由 service-integration-renderer 按开关计算（enableOperLog → operlog-topic；enableMq → <serviceId>-domain-event）
  mq: { producers: [{{#if enableOperLog}}operlog-topic{{#if enableMq}}, {{/if}}{{/if}}{{#if enableMq}}{{serviceId}}-domain-event{{/if}}], consumers: [] }
  xxl: { handlers: [{{#if enableJob}}mqRelayHandler{{/if}}], appNames: [{{#if enableJob}}{{artifactId}}{{/if}}] }
  docs: [docs/{{serviceId}}.md, docs/{{serviceId}}.en.md, docs/{{serviceId}}.jp.md, docs/{{serviceId}}.kr.md, docs/{{serviceId}}-i18n-status.yaml]
  resourceHints: { minimumMemoryMb: 512, recommendedMemoryMb: 768 }
  deprecation: { status: active }
  compatibility: { java: "25", node: ">=22.12.0", notes: [由 create-service 生成] }
