# 由 @omni-stack/cli {{generatorVersion}} 生成；模板 {{templateVersion}}。
server:
  port: {{servicePort}}

spring:
  application:
    name: {{artifactId}}
  profiles:
    active: ${SPRING_PROFILES_ACTIVE:dev}
  config:
    import:
      - optional:nacos:${spring.application.name}.yml?group=DEFAULT_GROUP&refreshEnabled=true
  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_SERVER_ADDR:localhost:8848}
        username: ${NACOS_USERNAME:nacos}
        password: ${NACOS_PASSWORD:nacos}
      config:
        server-addr: ${NACOS_SERVER_ADDR:localhost:8848}
        username: ${NACOS_USERNAME:nacos}
        password: ${NACOS_PASSWORD:nacos}
{{#if enableStream}}
    stream:
      rocketmq:
        binder:
          name-server: ${ROCKETMQ_NAME_SERVER:localhost:9876}
      bindings:
{{#if enableOperLog}}
        operlog-out-0:
          destination: operlog-topic
          content-type: application/json
{{/if}}
{{#if enableMq}}
        {{serviceId}}-domain-out-0:
          destination: {{serviceId}}-domain-event
          content-type: application/json
{{/if}}
{{/if}}
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${MYSQL_URL:jdbc:mysql://localhost:3306/{{databaseName}}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false}
    username: ${MYSQL_USERNAME:root}
    password: ${MYSQL_PASSWORD:root}
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}

management:
  server:
    port: {{managementPortExpression}}
  endpoints:
    web:
      exposure:
        include: health,info,prometheus,metrics
  otlp:
    metrics:
      export:
        enabled: false
  tracing:
    sampling:
      probability: ${TRACING_SAMPLING_PROBABILITY:0.0}
    export:
      otlp:
        enabled: ${OTLP_EXPORT_ENABLED:false}
  opentelemetry:
    tracing:
      export:
        otlp:
          endpoint: ${OTLP_TRACES_ENDPOINT:http://localhost:4318/v1/traces}
  metrics:
    distribution:
      percentiles-histogram:
        http.server.requests: true
        http.client.requests: true
    tags:
      service.name: ${spring.application.name}
      environment: ${OMNI_ENVIRONMENT:local}
      instance: ${HOSTNAME:local}

omni:
  service:
    name: {{artifactId}}
    display-name: {{displayName}}
    gateway-preauth:
      enabled: true
    internal-api:
      enabled: true
      token: ${OMNI_INTERNAL_API_TOKEN:}
    tenant:
      enabled: true
    data-scope:
      enabled: {{enableDataScope}}
    xss:
      enabled: true
{{#if enableJob}}

xxl:
  job:
    access-token: ${XXL_JOB_ACCESS_TOKEN:}
    admin:
      addresses: ${XXL_JOB_ADMIN_ADDRESSES:http://localhost:8088/xxl-job-admin}
      username: ${XXL_JOB_ADMIN_USERNAME:admin}
      password: ${XXL_JOB_ADMIN_PASSWORD:123456}
    executor:
      enabled: ${XXL_JOB_ENABLED:true}
      appname: {{artifactId}}
      port: {{xxlPortExpression}}
{{/if}}

logging:
  level:
    {{javaPackage}}: info
