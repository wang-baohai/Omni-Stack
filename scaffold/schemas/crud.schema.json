{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omni-stack.local/schemas/crud.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleId",
    "aggregateName",
    "displayName",
    "aggregateMode",
    "tableName",
    "tablePrefix",
    "apiPath",
    "permissionResource",
    "menuParent",
    "roleCodes",
    "tenant",
    "dataScope",
    "owner",
    "optimisticLock",
    "logicalDelete",
    "statusToggle",
    "fields",
    "uniqueConstraints",
    "indexes",
    "defaultSort",
    "forbiddenCapabilities"
  ],
  "properties": {
    "moduleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "aggregateName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "aggregateMode": { "const": "single-table" },
    "tableName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "tablePrefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_$" },
    "apiPath": { "type": "string", "pattern": "^/api/[a-z0-9/-]+$" },
    "permissionResource": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" },
    "menuParent": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$" },
    "roleCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "tenant": { "type": "boolean" },
    "dataScope": { "type": "boolean" },
    "owner": { "enum": ["none", "user", "unit", "user-and-unit"] },
    "optimisticLock": { "type": "boolean" },
    "logicalDelete": { "type": "boolean" },
    "statusToggle": { "type": "boolean" },
    "forbiddenCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "saga",
          "workflow",
          "inbox",
          "outbox",
          "multiAggregate",
          "piiInference",
          "complexMoney",
          "inventory",
          "overReceipt",
          "assetIdempotency"
        ]
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/field" }
    },
    "uniqueConstraints": {
      "type": "array",
      "items": { "$ref": "#/definitions/constraint" }
    },
    "indexes": {
      "type": "array",
      "items": { "$ref": "#/definitions/index" }
    },
    "defaultSort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "direction": { "enum": ["asc", "desc"] }
      }
    }
  },
  "definitions": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columnName",
        "comment",
        "javaType",
        "typescriptType",
        "databaseType",
        "required",
        "immutable",
        "list",
        "query",
        "form",
        "detail",
        "queryOperator",
        "pii",
        "control",
        "i18nKey"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "columnName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 200 },
        "javaType": { "enum": ["String", "Integer", "Long", "Boolean", "LocalDate", "LocalDateTime", "BigDecimal"] },
        "typescriptType": { "enum": ["string", "number", "boolean"] },
        "databaseType": { "enum": ["VARCHAR", "TEXT", "INT", "BIGINT", "TINYINT", "DATE", "DATETIME", "DECIMAL"] },
        "length": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "decimalPrecision": { "type": "integer", "minimum": 1, "maximum": 38 },
        "decimalScale": { "type": "integer", "minimum": 0, "maximum": 18 },
        "required": { "type": "boolean" },
        "immutable": { "type": "boolean" },
        "list": { "type": "boolean" },
        "query": { "type": "boolean" },
        "form": { "type": "boolean" },
        "detail": { "type": "boolean" },
        "queryOperator": { "enum": ["none", "eq", "like", "ge", "le", "between"] },
        "pii": { "enum": ["none", "name", "phone", "email", "id-card", "address", "custom"] },
        "maskStrategy": { "enum": ["none", "name", "phone", "email", "id-card", "address", "custom"] },
        "decimalAsString": { "type": "boolean" },
        "dateTimeFormat": { "enum": ["yyyy-MM-dd HH:mm:ss"] },
        "control": { "enum": ["input", "textarea", "number", "switch", "select", "date", "datetime"] },
        "dictionaryTypeCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "i18nKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]*$" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": {
        "name": { "type": "string", "pattern": "^uk_[a-z][a-z0-9_]*$" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": {
        "name": { "type": "string", "pattern": "^idx_[a-z][a-z0-9_]*$" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        }
      }
    }
  }
}
