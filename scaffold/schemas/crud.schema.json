{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omni-stack.local/schemas/crud.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "aggregateName", "tableName", "tablePrefix", "apiPath", "permissionResource", "fields"],
  "properties": {
    "moduleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "aggregateName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "tableName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "tablePrefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_$" },
    "apiPath": { "type": "string", "pattern": "^/api/[a-z0-9/-]+$" },
    "permissionResource": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" },
    "menuParent": { "type": "string", "minLength": 1 },
    "tenant": { "type": "boolean", "default": true },
    "dataScope": { "type": "boolean", "default": false },
    "optimisticLock": { "type": "boolean", "default": true },
    "logicalDelete": { "type": "boolean", "default": true },
    "forbiddenCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["saga", "workflow", "inbox", "outbox", "multiAggregate", "piiInference", "inventory"] }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "javaType", "typescriptType", "databaseType", "required", "pii"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "javaType": { "type": "string", "minLength": 1 },
          "typescriptType": { "type": "string", "minLength": 1 },
          "databaseType": { "type": "string", "minLength": 1 },
          "length": { "type": "integer", "minimum": 1 },
          "required": { "type": "boolean" },
          "pii": { "enum": ["none", "name", "phone", "email", "id-card", "address", "custom"] },
          "decimalAsString": { "type": "boolean" },
          "dateTimeFormat": { "enum": ["yyyy-MM-dd HH:mm:ss"] },
          "control": { "type": "string", "minLength": 1 },
          "i18nKey": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
