{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omni-stack.local/schemas/module.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modules"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "dependencies", "tenantProvisioning", "provisioningSeedIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": { "enum": ["foundation", "capability", "business", "infrastructure"] },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "tenantProvisioning": { "enum": ["local", "event", "none"] },
          "permissionRoots": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "provisioningSeedIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
