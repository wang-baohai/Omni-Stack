@echo off
:: ============================================================
:: Omni-Stack 中间件 — 停止
:: ============================================================
:: 用法：右键 → 以管理员身份运行
:: ============================================================

cd /d "%~dp0"

net session >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] 请右键此脚本，选择"以管理员身份运行"！
    echo.
    pause
    exit /b 1
)

echo ========== 停止中间件 ==========
docker compose down
echo.
echo ========== 已停止 ==========
echo.
pause
