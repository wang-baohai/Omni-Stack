{
  "name": "@omni-stack/wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:site": "node scripts/prepare-site.mjs",
    "build": "npm run prepare:site && vitepress build",
    "dev": "npm run prepare:site && vitepress dev --host 0.0.0.0 --port 4173 --strictPort",
    "preview": "vitepress preview --host 0.0.0.0 --port 4173",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "mermaid": "11.17.2",
    "vitepress": "1.6.4",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
